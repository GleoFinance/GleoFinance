# Names only. Copy to .env.local and fill in the values you have; every
# variable is optional and the site runs on public endpoints without them.

# Private Robinhood Chain RPC for server reads (e.g. an Alchemy URL).
ROBINHOOD_RPC_URL=
# Private RPC the browser may use as a fallback; restrict it to your domain.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
# WalletConnect project id from cloud.reown.com (allowlist gleo.finance).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Only when self-hosting behind your own proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=
# With TRUST_PROXY_HEADERS=1: number of proxies appending to X-Forwarded-For (default 1).
TRUSTED_PROXY_HOPS=
# With TRUST_PROXY_HEADERS=1: header your proxy overwrites with the client address (e.g. x-real-ip). Leave empty otherwise.
CLIENT_IP_HEADER=
